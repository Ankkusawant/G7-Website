async function downloadCurrentPdf(){
  if(!current) return;
  try{
    showLoading('Preparing PDF…'); await sleep(30);
    const jsPDFCtor = window.jspdf.jsPDF;
    const stage=$('#pdfStage'); stage.innerHTML='';
    const blocks=buildBlocks(current); paginate(blocks,stage);
    const pages=$$('.pdf-page',stage); if(!pages.length){hideLoading();return;}
    const pdf=new jsPDFCtor({orientation:'portrait',unit:'mm',format:'a4',compress:true});
    const PW=210,PH=297;
    for(let i=0;i<pages.length;i++){
      showLoading('Generating PDF… page '+(i+1)+' of '+pages.length);
      await waitForImages(pages[i]); await nextFrame();
      const canvas=await html2canvas(pages[i],{scale:2,useCORS:true,allowTaint:false,backgroundColor:'#ffffff',logging:false,width:PAGE_W,height:PAGE_H,windowWidth:PAGE_W,windowHeight:PAGE_H});
      const imgData=canvas.toDataURL('image/jpeg',0.94);
