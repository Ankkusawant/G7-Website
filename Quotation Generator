/* ============================================================
   7. CLOUD API
   ============================================================ */
async function cloudRequest(action, params, opts){
  if(!settings.cloudUrl) throw new Error('Cloud URL not set in Settings');
  if(!settings.cloudSecret) throw new Error('Cloud secret not set in Settings');
  const body = Object.assign({action:action, secret:settings.cloudSecret}, params||{});
  const res = await fetch(settings.cloudUrl, {
    method:'POST',
    // text/plain → simple request → no CORS preflight → works with Apps Script
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body: JSON.stringify(body),
    redirect:'follow'
  });
  if(!res.ok) throw new Error('HTTP '+res.status);
  let data;
  try{ data = await res.json(); }catch(e){ throw new Error('Invalid response from backend'); }
  if(!data.ok) throw new Error(data.error||'Cloud request failed');
  return data.data;
}
async function testCloudConnection(silent){
  const out=$('#cloudTestResult');
  try{
    if(!settings.cloudUrl||!settings.cloudSecret) throw new Error('Enter URL and Secret first');
    const r = await cloudRequest('ping', {});
    if(out) out.innerHTML='<span style="color:var(--ok);font-weight:700;">✓ Connected</span> &nbsp; Server time: '+esc(r.time||'');
    $('#cloudStatus').classList.add('ok'); $('#cloudStatus').classList.remove('err');
    $('#cloudStatusText').textContent='Cloud: connected';
    if(!silent) toast('Cloud connection OK');
    return true;
  }catch(err){
    if(out) out.innerHTML='<span style="color:var(--danger);font-weight:700;">✗ '+esc(err.message)+'</span>';
    $('#cloudStatus').classList.add('err'); $('#cloudStatus').classList.remove('ok');
    $('#cloudStatusText').textContent='Cloud: error';
    if(!silent) toast('Connection failed: '+err.message);
    return false;
  }
}
async function fetchNextCloudNumber(){
  if(!settings.cloudUrl||!settings.cloudSecret){toast('Configure cloud in Settings first');return null;}
  try{
    const r = await cloudRequest('nextNumber', {});
    return r.number;
  }catch(err){ toast('Could not fetch number: '+err.message); return null; }
}

/* ============================================================
   8. PDF (base64) BUILDER FOR CLOUD
   ============================================================ */
async function generatePdfBase64(q){
  const jsPDFCtor = window.jspdf && window.jspdf.jsPDF;
  if(!jsPDFCtor) throw new Error('jsPDF not loaded');
  const stage = $('#pdfStage');
  stage.innerHTML = '';
  const blocks = buildBlocks(q);
  paginate(blocks, stage);
  const pages = $$('.pdf-page', stage);
  if(!pages.length) throw new Error('No pages rendered');

  const pdf = new jsPDFCtor({orientation:'portrait',unit:'mm',format:'a4',compress:true});
  const PW=210, PH=297;

  for(let i=0;i<pages.length;i++){
    showLoading('Generating PDF… page '+(i+1)+' of '+pages.length);
    await waitForImages(pages[i]);
    await nextFrame();
    const canvas = await html2canvas(pages[i],{
      scale:2, useCORS:true, allowTaint:false, backgroundColor:'#ffffff', logging:false,
      width:PAGE_W, height:PAGE_H, windowWidth:PAGE_W, windowHeight:PAGE_H
    });
    if(!canvas||!canvas.width) throw new Error('Empty canvas');
    const imgData = canvas.toDataURL('image/jpeg',0.9);
    if(i>0) pdf.addPage();
    pdf.addImage(imgData,'JPEG',0,0,PW,PH,undefined,'FAST');
    await sleep(10);
  }
  stage.innerHTML = '';

  const ab = pdf.output('arraybuffer');
  const bytes = new Uint8Array(ab);
  let bin = '';
  const chunk = 0x8000;
  for(let i=0;i<bytes.length;i+=chunk){
    bin += String.fromCharCode.apply(null, bytes.subarray(i, i+chunk));
  }
  return btoa(bin);
}
function waitForImages(root){
  const imgs = $$('img', root);
  if(!imgs.length) return Promise.resolve();
  return Promise.all(imgs.map(img=>{
    if(img.complete && img.naturalWidth>0) return Promise.resolve();
    return new Promise(res=>{
      img.onload=res; img.onerror=res;
      setTimeout(res, 3000);
    });
  }));
}

/* ============================================================
   9. SAVE TO CLOUD
   ============================================================ */
async function saveToCloud(){
  if(!current) return;
  if(!settings.cloudUrl||!settings.cloudSecret){ toast('Configure cloud in Settings first'); return; }
  try{
    showLoading('Generating PDF for upload…'); await sleep(30);
    const pdfBase64 = await generatePdfBase64(current);
    showLoading('Uploading to Google Sheets / Drive…');
    const res = await cloudRequest('saveQuotation', {
      quotation: current,
      pdfBase64: pdfBase64,
      pdfFilename: pdfFileName(current)
    });
    current.pdfUrl = res.pdfUrl || '';
    current.pdfId  = res.pdfId  || '';
    current.number = res.number || current.number;
    current._cloud = true;
    const numInput = $('[data-path="number"]');
    if(numInput) numInput.value = current.number;
    saveCurrentQuotation(true);
    $('#cloudStatus').classList.add('ok'); $('#cloudStatus').classList.remove('err');
    $('#cloudStatusText').textContent='Cloud: connected';
    toast('Saved to cloud: '+res.number);
  }catch(err){
    console.error(err);
    toast('Cloud save failed: '+err.message);
  }finally{ hideLoading(); }
}
function pdfFileName(q){
  const safe=String(q.number||'Quotation').replace(/[^\w\-]+/g,'-');
  return 'G-7-Quotation-'+safe+'.pdf';
}

