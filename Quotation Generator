  if(!list.length){
    tbody.innerHTML='<tr><td colspan="8" style="text-align:center;padding:36px;color:var(--muted);">'+
      (quotationSource==='cloud'?'No cloud quotations. Configure the backend in Settings and click Refresh.':'No local quotations found.')+
      '</td></tr>';
    return;
  }
  tbody.innerHTML=list.map(q=>{
    const T=computeTotals(q);
    const st=String(q.status||'Draft').toLowerCase();
    const cloudBadge = q.pdfUrl
      ? '<a href="'+esc(q.pdfUrl)+'" target="_blank" rel="noopener" style="color:#0f766e;font-weight:700;text-decoration:none;">☁ PDF</a>'
      : (q._source==='cloud'?'<span style="color:var(--muted);font-size:11px;">—</span>':'<span style="color:var(--muted);font-size:11px;">Local</span>');
    return '<tr>'+
      '<td class="q-num-cell">'+esc(q.number)+'</td>'+
      '<td>'+esc(q.client.name||'—')+(q.client.business?'<div style="font-size:11.5px;color:var(--muted);">'+esc(q.client.business)+'</div>':'')+'</td>'+
      '<td>'+esc(q.project.name||q.project.type||'—')+'</td>'+
      '<td class="q-amt-cell">'+fmt(T.grandTotal)+'</td>'+
      '<td>'+formatDate(q.date)+'</td>'+
      '<td><span class="badge '+st+'">'+esc(q.status||'Draft')+'</span></td>'+
      '<td>'+cloudBadge+'</td>'+
      '<td><div class="row-actions">'+
        '<button class="btn btn-sm btn-light" data-act="view" data-id="'+q.id+'">View</button>'+
        '<button class="btn btn-sm btn-light" data-act="edit" data-id="'+q.id+'">Edit</button>'+
        '<button class="btn btn-sm btn-light" data-act="dup"  data-id="'+q.id+'">Duplicate</button>'+
        '<button class="btn btn-sm btn-light" data-act="pdf"  data-id="'+q.id+'">PDF</button>'+
        (quotationSource==='cloud'
          ? '<button class="btn btn-sm btn-light" data-act="status" data-id="'+q.id+'">Status</button>'
          : '')+
        '<button class="btn btn-sm btn-danger" data-act="del" data-id="'+q.id+'">Delete</button>'+
      '</div></td>'+
    '</tr>';
  }).join('');
}
function findQuotationById(id){
  if(quotationSource==='cloud') return cloudList.find(x=>x.id===id);
  return quotations.find(x=>x.id===id);
}
function bindQuotationsTable(){
  $('#qSearch').addEventListener('input',renderQuotationsTable);
  $('#qStatusFilter').addEventListener('change',renderQuotationsTable);
  $('#sourceToggle').addEventListener('click',e=>{
    const b=e.target.closest('button[data-source]'); if(!b)return;
    quotationSource=b.dataset.source;
    $$('#sourceToggle button').forEach(x=>x.classList.toggle('active',x===b));
    if(quotationSource==='cloud') refreshCloudList(); else renderQuotationsTable();
  });
  $('#refreshCloudBtn').addEventListener('click',refreshCloudList);

  $('#quotationsBody').addEventListener('click',async e=>{
    const btn=e.target.closest('button[data-act]'); if(!btn)return;
    const id=btn.dataset.id, act=btn.dataset.act;
    const q=findQuotationById(id);
    if(!q)return;

    if(act==='view'){ loadQuotation(q); switchView('editor'); openClientView(); }
    else if(act==='edit'){ loadQuotation(q); switchView('editor'); toast('Loaded '+q.number); }
    else if(act==='dup'){
      const copy=migrateQuotation(JSON.parse(JSON.stringify(q)));
      copy.id=uid();
      copy.number=nextQuotationNumber();
      copy.status='Draft';
      copy.date=toISO(new Date());
      copy.validUntil=toISO(new Date(Date.now()+15*86400000));
      copy.createdAt=Date.now(); copy.updatedAt=Date.now();
      quotations.push(copy); persistQuotations(); renderQuotationsTable();
      toast('Duplicated as '+copy.number);
    }
    else if(act==='pdf'){ await downloadPdfForQuotation(q); }
    else if(act==='status'){
      const next = prompt('Set status for '+q.number+':\n(Draft, Sent, Pending, Accepted, Paid, Rejected, Expired)', q.status);
      if(!next) return;
      try{
        await cloudRequest('updateStatus',{id:q.id,status:next});
        q.status=next;
        renderQuotationsTable();
        toast('Status updated to '+next);
      }catch(err){ toast('Update failed: '+err.message); }
    }
    else if(act==='del'){
      if(!confirm('Delete quotation '+q.number+'? This cannot be undone.')) return;
      if(quotationSource==='cloud' && q._source==='cloud'){
        try{
          await cloudRequest('deleteQuotation',{id:q.id});
          cloudList=cloudList.filter(x=>x.id!==q.id);
          renderQuotationsTable();
          toast('Deleted from cloud');
        }catch(err){ toast('Delete failed: '+err.message); }
      }else{
        quotations=quotations.filter(x=>x.id!==id);
        persistQuotations(); renderQuotationsTable(); toast('Quotation deleted');
      }
    }
  });
}
async function refreshCloudList(){
  if(!settings.cloudUrl||!settings.cloudSecret){
    toast('Configure cloud in Settings first'); return;
  }
  try{
    showLoading('Loading cloud quotations…');
    const search = ($('#qSearch').value||'').trim();
    const status = $('#qStatusFilter').value;
    const r = await cloudRequest('listQuotations',{search:search,status:status});
    cloudList = (r.quotations||[]).map(x=>Object.assign(migrateQuotation({}),x,{
      items: (x.items||[]).map(it=>Object.assign({id:uid(),name:'',desc:'',qty:1,price:0,discount:0},it)),
      terms: x.terms || [],
      discount: { mode:'percent', value:0 },
      gst: { enabled:false, percent:18 }
    }));
    // fill missing local fields for cloud rows
    cloudList = cloudList.map(q=>{
      const base = migrateQuotation({});
      const m = Object.assign({}, base, q);
      m.client = Object.assign({}, base.client, q.client||{});
      m.project = Object.assign({}, base.project, q.project||{});
      m._source = 'cloud';
      return m;
    });
    renderQuotationsTable();
    toast('Loaded '+cloudList.length+' cloud quotations');
  }catch(err){
    toast('Cloud load failed: '+err.message);
  }finally{ hideLoading(); }
}

/* ============================================================
   20. SAVE / LOAD
   ============================================================ */
function saveCurrentQuotation(silent){
  if(!current) return;
  current.updatedAt=Date.now();
  const idx=quotations.findIndex(x=>x.id===current.id);
  if(idx>=0) quotations[idx]=JSON.parse(JSON.stringify(current));
  else quotations.push(JSON.parse(JSON.stringify(current)));
  persistQuotations(); renderQuotationsTable(); saveDraft();
  if(!silent) toast('Saved locally: '+current.number);
}
function loadQuotation(q){ current=migrateQuotation(JSON.parse(JSON.stringify(q))); fillForm(); }
function hasMeaningfulData(q){
  if(!q) return false;
  if(q.client&&(q.client.name||q.client.business)) return true;
  if(q.items&&q.items.length) return true;
  return false;
}
async function startNewQuotation(skipAutoSave){
  if(!skipAutoSave&&current&&hasMeaningfulData(current)){
    const exists=quotations.some(x=>x.id===current.id);
    if(!exists){saveCurrentQuotation(true);toast('Previous quotation saved as '+current.number);}
  }
  current=createNewQuotation();
  // If cloud auto-number is enabled, fetch from Sheets
  if(settings.cloudAutoNumber==='yes' && settings.cloudUrl && settings.cloudSecret){
    const n = await fetchNextCloudNumber();
    if(n){ current.number = n; toast('Cloud assigned: '+n); }
  }
  fillForm();
  try{localStorage.setItem(LS_DRAFT,JSON.stringify(current));}catch(e){}
}

/* ============================================================
   21. VIEWS
   ============================================================ */
function switchView(name){
  $$('.view').forEach(v=>v.classList.remove('active'));
  const el=$('#view-'+name); if(el)el.classList.add('active');
  $$('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.view===name));
  if(name==='editor') setTimeout(()=>{if(previewDirty)renderPreview();},20);
  if(name==='quotations') renderQuotationsTable();
}

/* ============================================================
   22. LOGO
   ============================================================ */
function processLogoFile(file){
  return new Promise((resolve,reject)=>{
    const reader=new FileReader();
    reader.onload=ev=>{
      const img=new Image();
      img.onload=()=>{
        const MAX=560;
        let w=img.naturalWidth||img.width, hh=img.naturalHeight||img.height;
        if(w>MAX){hh=Math.round(hh*MAX/w);w=MAX;}
        if(hh>MAX){w=Math.round(w*MAX/hh);hh=MAX;}
        const c=document.createElement('canvas'); c.width=w; c.height=hh;
        c.getContext('2d').drawImage(img,0,0,w,hh);
        resolve(c.toDataURL('image/png'));
      };
      img.onerror=reject; img.src=ev.target.result;
    };
    reader.onerror=reject; reader.readAsDataURL(file);
  });
}
function bindLogoEvents(){
  $('#uploadLogoBtn').addEventListener('click',()=>$('#logoInput').click());
  $('#logoInput').addEventListener('change',async e=>{
    const f=e.target.files&&e.target.files[0]; e.target.value='';
    if(!f)return;
    try{
      const dataUrl=await processLogoFile(f);
      settings.logo=dataUrl; persistSettings(); applySettings(); schedulePreview();
      toast('Logo uploaded');
    }catch(err){ console.error(err); toast('Could not read that image'); }
  });
  $('#removeLogoBtn').addEventListener('click',()=>{
    if(!settings.logo){toast('No logo to remove');return;}
    if(!confirm('Remove the G-7 logo?'))return;
    settings.logo=''; persistSettings(); applySettings(); schedulePreview();
    toast('Logo removed');
  });
}

/* ============================================================
   23. DATA IMPORT/EXPORT
   ============================================================ */
function bindDataEvents(){
  $('#exportDataBtn').addEventListener('click',()=>{
    const data={app:'G-7 Quotation Generator',version:2,exportedAt:new Date().toISOString(),
      settings, quotations};
    const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='g7-quotations-backup-'+toISO(new Date())+'.json';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(()=>URL.revokeObjectURL(a.href),2000);
    toast('Backup exported');
  });
  $('#importDataBtn').addEventListener('click',()=>$('#importFileInput').click());
  $('#importFileInput').addEventListener('change',e=>{
    const f=e.target.files&&e.target.files[0]; e.target.value='';
    if(!f)return;
    const r=new FileReader();
    r.onload=ev=>{
      try{
        const d=JSON.parse(ev.target.result);
        if(d.settings){settings=Object.assign({},DEFAULT_SETTINGS,d.settings);persistSettings();}
        if(Array.isArray(d.quotations)){quotations=d.quotations.map(migrateQuotation);persistQuotations();}
        applySettings(); renderQuotationsTable(); toast('Backup imported');
      }catch(err){console.error(err);toast('Invalid backup file');}
    };
    r.readAsText(f);
  });
  $('#clearAllBtn').addEventListener('click',()=>{
    if(!confirm('Delete ALL local quotations, settings and the uploaded logo? This cannot be undone.'))return;
    try{localStorage.removeItem(LS_QUOTES);localStorage.removeItem(LS_SETTINGS);localStorage.removeItem(LS_DRAFT);}catch(e){}
    quotations=[]; settings=Object.assign({},DEFAULT_SETTINGS);
    applySettings(); renderQuotationsTable(); startNewQuotation(true); renderPreview();
    toast('All local data deleted');
  });
}

/* ============================================================
   24. DROPDOWNS
   ============================================================ */
function buildProjectTypeSelect(){
  $('#projectTypeSelect').innerHTML=STANDARD_TYPES.map(t=>'<option>'+esc(t)+'</option>').join('');
}
function buildFeatureSelect(){
  let html='<option value="">— Select a feature to add —</option>';
  Object.keys(FEATURE_LIBRARY).forEach(g=>{
    html+='<optgroup label="'+esc(g)+'">';
    FEATURE_LIBRARY[g].forEach(f=>{html+='<option value="'+esc(f)+'">'+esc(f)+'</option>';});
    html+='</optgroup>';
  });
  $('#featureSelect').innerHTML=html;
}

/* ============================================================
   25. BUTTONS
   ============================================================ */
function bindButtons(){
  $$('.nav-btn').forEach(b=>b.addEventListener('click',()=>switchView(b.dataset.view)));
  $('#newQuotationBtn').addEventListener('click',async()=>{await startNewQuotation();switchView('editor');});
  $('#newQuotationBtn2').addEventListener('click',async()=>{await startNewQuotation();switchView('editor');});

  $('#addFeatureBtn').addEventListener('click',()=>{
    const sel=$('#featureSelect'); const name=sel.value;
    if(!name){toast('Select a feature first');return;}
    current.items.push({id:uid(),name,desc:'',qty:1,price:0,discount:0});
    sel.value=''; renderItems(); onModelChange();
    const rows=$$('#itemsList .item-row'); const last=rows[rows.length-1];
    if(last){const p=last.querySelector('[data-field="price"]');if(p)p.focus();}
  });
  $('#addCustomItemBtn').addEventListener('click',()=>{
    current.items.push({id:uid(),name:'Custom Item',desc:'',qty:1,price:0,discount:0});
    renderItems(); onModelChange();
    const rows=$$('#itemsList .item-row'); const last=rows[rows.length-1];
    if(last){const n=last.querySelector('[data-field="name"]');if(n){n.focus();n.select();}}
  });
  $('#addTermBtn').addEventListener('click',()=>{
    current.terms.push('New term — edit this text.');
    renderTerms(); onModelChange();
    const tas=$$('#termsList textarea'); if(tas.length)tas[tas.length-1].focus();
  });

  $('#downloadPdfBtn').addEventListener('click',downloadCurrentPdf);
  $('#printBtn').addEventListener('click',()=>printPages(current));
  $('#clientViewBtn').addEventListener('click',openClientView);
  $('#saveQuotationBtn').addEventListener('click',()=>saveCurrentQuotation(false));
  $('#saveCloudBtn').addEventListener('click',saveToCloud);

  $('#testCloudBtn').addEventListener('click',()=>testCloudConnection(false));
  $('#fetchNextNumberBtn').addEventListener('click',async()=>{
    const n = await fetchNextCloudNumber();
    if(n && current){
      current.number = n;
      const inp=$('[data-path="number"]'); if(inp)inp.value=n;
      toast('Next number: '+n);
    }
  });

  $('#clientCloseBtn').addEventListener('click',closeClientView);
  $('#clientPrintBtn').addEventListener('click',()=>printPages(current));
  $('#clientPdfBtn').addEventListener('click',downloadCurrentPdf);

  $('#togglePreviewBtn').addEventListener('click',function(){
    const grid=$('#editorGrid');
    const showing=grid.classList.toggle('show-preview');
    this.textContent=showing?'✎ Back to Editor':'👁 Show Quotation Preview';
    if(showing){setTimeout(()=>{renderPreview();window.scrollTo({top:0,behavior:'smooth'});},30);}
  });

  document.addEventListener('keydown',e=>{
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();saveCurrentQuotation(false);}
    if((e.ctrlKey||e.metaKey)&&e.shiftKey&&e.key.toLowerCase()==='s'){e.preventDefault();saveToCloud();}
    if(e.key==='Escape'&&$('#clientView').classList.contains('open')) closeClientView();
  });
}

/* ============================================================
   26. INIT
   ============================================================ */
function init(){
  buildProjectTypeSelect();
  buildFeatureSelect();
  applySettings();

  let draft=null;
  try{const raw=localStorage.getItem(LS_DRAFT);if(raw)draft=JSON.parse(raw);}catch(e){}

  current = draft?migrateQuotation(draft):createNewQuotation();

  bindFields();
  bindItemsEvents();
  bindTermsEvents();
  bindLogoEvents();
  bindDataEvents();
  bindQuotationsTable();
  bindButtons();

  fillForm();
  renderQuotationsTable();
  switchView('editor');
  setTimeout(()=>renderPreview(),60);

  if(settings.cloudUrl&&settings.cloudSecret){
    testCloudConnection(true);
  }
  if(!settings.logo){
    setTimeout(()=>toast('Tip: upload your G-7 logo in Settings for branded quotations'),900);
  }
}

if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init);
else init();

})();
</script>
