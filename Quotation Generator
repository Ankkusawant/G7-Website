}
function updateLineAmount(i){
  const row=$('#itemsList .item-row[data-idx="'+i+'"]'); if(!row)return;
  const it=current.items[i]; if(!it)return;
  const g=num(it.qty)*num(it.price); const d=Math.min(num(it.discount),g);
  const b=row.querySelector('.line-total b'); if(b)b.textContent=fmt(g-d);
}
function bindItemsEvents(){
  const list=$('#itemsList');
  list.addEventListener('input',e=>{
    const el=e.target; if(el.dataset.item===undefined)return;
    const i=parseInt(el.dataset.item,10); const f=el.dataset.field;
    if(!current.items[i])return;
    current.items[i][f]=(el.type==='number')?num(el.value):el.value;
    updateLineAmount(i); onModelChange();
  });
  list.addEventListener('click',e=>{
    const btn=e.target.closest('button'); if(!btn)return;
    const row=btn.closest('.item-row'); if(!row)return;
    const i=parseInt(row.dataset.idx,10);
    if(btn.dataset.remove!==undefined){current.items.splice(i,1);renderItems();onModelChange();}
    else if(btn.dataset.move==='up'&&i>0){const it=current.items.splice(i,1)[0];current.items.splice(i-1,0,it);renderItems();onModelChange();}
    else if(btn.dataset.move==='down'&&i<current.items.length-1){const it=current.items.splice(i,1)[0];current.items.splice(i+1,0,it);renderItems();onModelChange();}
  });
}
function renderTerms(){
  const list=$('#termsList');
  list.innerHTML=current.terms.map((t,i)=>
    '<div class="term-row"><textarea class="inp" rows="2" data-term="'+i+'">'+esc(t)+'</textarea>'+
    '<button class="icon-btn danger" data-term-remove="'+i+'" title="Remove">✕</button></div>'
  ).join('')||'<div class="empty-hint">No terms added. Click <b>+ Add Term</b>.</div>';
}
function bindTermsEvents(){
  const list=$('#termsList');
  list.addEventListener('input',e=>{
    const el=e.target; if(el.dataset.term===undefined)return;
    current.terms[parseInt(el.dataset.term,10)]=el.value; onModelChange();
  });
  list.addEventListener('click',e=>{
    const btn=e.target.closest('button[data-term-remove]'); if(!btn)return;
    current.terms.splice(parseInt(btn.dataset.termRemove,10),1);
    renderTerms(); onModelChange();
  });
}

