const FEATURE_LIBRARY = {
  'Website — Pages':['Responsive Design','Home Page','About Us','Contact Page','Services Page','Product Catalogue','Product Detail Pages','Image Gallery','Search'],
  'Website — Integrations':['WhatsApp Integration','Contact Form','Google Maps','Social Media Integration','Basic SEO','Google Search Console Setup','Analytics Setup','Domain Setup','Hosting Setup','SSL / HTTPS'],
  'E-commerce':['Shopping Cart','Online Payment Integration','Order Management','Admin Panel','Product Management','Customer Login','Database'],
  'Design & Extras':['Custom Design','Mobile Optimization','Blog','Reviews / Testimonials'],
  'Automation':['Excel VBA Automation','Excel Dashboard','Data Validation','Automated Reports','PDF Processing','Data Extraction','Email Automation','Power Automate Integration','Custom Business Workflow','Custom Excel Tool']
};

const DEFAULT_PAYMENT_TERMS = '50% advance payment is required to confirm the project and begin development. The remaining 50% payment is payable after testing and approval, before final delivery/launch.';
const DEFAULT_TERMS = [
  'Development will begin after receipt of the agreed advance payment.',
  'The estimated delivery timeline starts after receipt of the advance payment and all required content/materials from the client.',
  'Any features or requirements outside the approved scope may incur additional charges.',
  'Domain, hosting, paid APIs, plugins, third-party services and other external costs are not included unless specifically mentioned in this quotation.',
  'The client is responsible for providing accurate content, images, logos and other required materials.',
  'The final project will be delivered/launched after the remaining payment has been received.',
  'This quotation is valid until the date mentioned above.'
];
const DEFAULT_SETTINGS = {
  businessName:'G-7', tagline:'Websites & Business Automation',
  website:'https://g-7.shop/', email:'', phone:'', address:'', logo:'',
  cloudUrl:'', cloudSecret:'', cloudAutoNumber:'no'
};

/* ============================================================
   2. UTILITIES
   ============================================================ */
const $  = (s, r) => (r || document).querySelector(s);
const $$ = (s, r) => Array.prototype.slice.call((r || document).querySelectorAll(s));
const num = v => { const n = parseFloat(v); return isNaN(n) ? 0 : n; };
const round2 = v => Math.round((v + Number.EPSILON) * 100) / 100;
const fmt = v => '\u20B9' + round2(num(v)).toLocaleString('en-IN',{minimumFractionDigits:2, maximumFractionDigits:2});
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function nl2br(s){return esc(s).replace(/\n/g,'<br>');}
function uid(){return 'q'+Date.now().toString(36)+Math.random().toString(36).slice(2,7);}
function toISO(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function formatDate(s){if(!s)return '—';const d=new Date(String(s).length===10?s+'T00:00:00':s);return isNaN(d)?s:d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});}
function getPath(o,p){return p.split('.').reduce((a,k)=>a==null?undefined:a[k],o);}
function setPath(o,p,v){const k=p.split('.');const l=k.pop();let c=o;for(const x of k){if(c[x]==null||typeof c[x]!=='object')c[x]={};c=c[x];}c[l]=v;}
function h(tag,cls,html){const e=document.createElement(tag);if(cls)e.className=cls;if(html!=null)e.innerHTML=html;return e;}
let toastTimer=null;
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2800);}
function showLoading(t){$('#loadingText').textContent=t||'Working…';$('#loadingOverlay').classList.add('open');}
function hideLoading(){$('#loadingOverlay').classList.remove('open');}
function nextFrame(){return new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r)));}
async function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

/* ============================================================
   3. STATE
   ============================================================ */
let settings = loadSettings();
let quotations = loadQuotations();
let current = null;
let previewDirty = false;
let quotationSource = 'local'; // 'local' | 'cloud'
let cloudList = [];

function loadSettings(){
  try{const r=localStorage.getItem(LS_SETTINGS);if(r)return Object.assign({},DEFAULT_SETTINGS,JSON.parse(r));}catch(e){}
  return Object.assign({},DEFAULT_SETTINGS);
}
function persistSettings(){try{localStorage.setItem(LS_SETTINGS,JSON.stringify(settings));}catch(e){toast('Storage full');}}
function loadQuotations(){
  try{const r=localStorage.getItem(LS_QUOTES);if(r){const a=JSON.parse(r);if(Array.isArray(a))return a;}}catch(e){}
  return [];
}
function persistQuotations(){try{localStorage.setItem(LS_QUOTES,JSON.stringify(quotations));}catch(e){toast('Storage full');}}
function saveDraft(){if(!current)return;try{localStorage.setItem(LS_DRAFT,JSON.stringify(current));}catch(e){}}

/* ============================================================
   4. MODEL
   ============================================================ */
function nextQuotationNumber(){
  const year = new Date().getFullYear();
  const prefix = 'G7-' + year + '-';
  let max = 0;
  quotations.forEach(q=>{
    if(q&&q.number&&q.number.indexOf(prefix)===0){
      const n=parseInt(q.number.slice(prefix.length),10);
      if(!isNaN(n)&&n>max)max=n;
    }
  });
  return prefix + String(max+1).padStart(3,'0');
}
function createNewQuotation(){
  const today=new Date();const valid=new Date(today.getTime()+15*86400000);
  return {
    id: uid(),
    number: nextQuotationNumber(),
    status:'Draft',
    date: toISO(today),
    validUntil: toISO(valid),
    client:{name:'',business:'',email:'',phone:'',address:'',gst:''},
    project:{name:'',type:'Business Website',customType:'',delivery:'',overview:''},
    items:[], discount:{mode:'percent',value:0},
    gst:{enabled:false,percent:18},
    advancePercent:50,
    paymentTerms:DEFAULT_PAYMENT_TERMS,
    terms:DEFAULT_TERMS.slice(),
    createdAt:Date.now(), updatedAt:Date.now(),
    pdfUrl:'', pdfId:'', _cloud:false
  };
}
function migrateQuotation(q){
  const base=createNewQuotation();
  const out=Object.assign({},base,q||{});
  out.client=Object.assign({},base.client,(q&&q.client)||{});
  out.project=Object.assign({},base.project,(q&&q.project)||{});
  out.discount=Object.assign({},base.discount,(q&&q.discount)||{});
  out.gst=Object.assign({},base.gst,(q&&q.gst)||{});
  if(!Array.isArray(out.items))out.items=[];
  out.items=out.items.map(it=>Object.assign({id:uid(),name:'',desc:'',qty:1,price:0,discount:0},it||{}));
  if(!Array.isArray(out.terms)||!out.terms.length)out.terms=DEFAULT_TERMS.slice();
  if(typeof out.advancePercent!=='number')out.advancePercent=50;
  if(!out.paymentTerms)out.paymentTerms=DEFAULT_PAYMENT_TERMS;
  if(!out.id)out.id=uid();
  if(!out.number)out.number=nextQuotationNumber();
  return out;
}

/* ============================================================
   5. TOTALS
   ============================================================ */
function computeTotals(q){
  let subtotal=0;
  const lines=(q.items||[]).map(it=>{
    const g=num(it.qty)*num(it.price);
    const d=Math.min(num(it.discount),g);
    const a=round2(g-d);
    subtotal+=a;
    return {gross:round2(g),disc:round2(d),amount:a};
  });
  subtotal=round2(subtotal);
  const d=q.discount||{mode:'percent',value:0};
  let dAmt=(d.mode==='percent')?subtotal*num(d.value)/100:num(d.value);
  dAmt=round2(Math.max(0,Math.min(dAmt,subtotal)));
  const after=round2(subtotal-dAmt);
  const gstPct=(q.gst&&q.gst.enabled)?num(q.gst.percent):0;
  const gstAmt=round2(after*gstPct/100);
  const grand=round2(after+gstAmt);
  const advPct=Math.max(0,Math.min(100,num(q.advancePercent)));
  const advAmt=round2(grand*advPct/100);
  const bal=round2(grand-advAmt);
  return {subtotal,discountAmount:dAmt,afterDiscount:after,gstPercent:gstPct,gstAmount:gstAmt,
    grandTotal:grand,advancePercent:advPct,advanceAmount:advAmt,balanceAmount:bal,lines};
}

/* ============================================================
   6. BRANDING
