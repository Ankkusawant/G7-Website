<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>G-7 Quotation Generator</title>
<meta name="description" content="G-7 Quotation Generator — create professional quotations for websites & business automation.">

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
:root{
  --navy:#0e2a47; --blue:#2563eb; --blue-dark:#1d4ed8;
  --bg:#f2f5f9; --card:#ffffff; --border:#dde4ec; --text:#1c2b3a;
  --muted:#6b7c93; --danger:#dc2626; --ok:#15803d; --warn:#b45309;
  --radius:10px;
  --shadow:0 1px 2px rgba(16,32,52,.06), 0 6px 18px rgba(16,32,52,.06);
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{font-family:'Segoe UI',system-ui,-apple-system,Roboto,'Helvetica Neue',Arial,sans-serif;
  background:var(--bg);color:var(--text);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;}
button{font-family:inherit;} input,select,textarea{font-family:inherit;}

.app-header{position:sticky;top:0;z-index:60;background:var(--navy);color:#fff;box-shadow:0 2px 10px rgba(9,24,42,.25);}
.app-header-inner{max-width:1600px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.brand{display:flex;align-items:center;gap:12px;min-width:0;}
.brand-logo{height:46px;width:auto;max-width:160px;object-fit:contain;background:#fff;border-radius:10px;padding:3px;}
.brand-logo-fallback{height:46px;min-width:46px;padding:0 12px;border-radius:10px;background:#fff;color:var(--navy);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:20px;}
.brand-text h1{margin:0;font-size:16px;font-weight:700;white-space:nowrap;}
.brand-text p{margin:0;font-size:11.5px;color:#a8bdd6;}
.header-spacer{flex:1 1 auto;}
.header-nav{display:flex;gap:4px;background:rgba(255,255,255,.08);padding:4px;border-radius:9px;}
.nav-btn{background:transparent;border:0;color:#c9d8ea;padding:7px 14px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600;transition:.15s;white-space:nowrap;}
.nav-btn:hover{background:rgba(255,255,255,.1);color:#fff;}
.nav-btn.active{background:#fff;color:var(--navy);}
.cloud-status{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;color:#c9d8ea;padding:5px 10px;border-radius:20px;background:rgba(255,255,255,.08);}
.cloud-status .dot{width:8px;height:8px;border-radius:50%;background:#94a3b8;}
.cloud-status.ok .dot{background:#22c55e;}
.cloud-status.err .dot{background:#ef4444;}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid transparent;border-radius:8px;padding:9px 15px;font-size:13px;font-weight:600;cursor:pointer;transition:.15s;white-space:nowrap;background:#eef2f7;color:var(--text);}
.btn:hover{background:#e3e9f1;} .btn:active{transform:translateY(1px);}
.btn-primary{background:var(--blue);color:#fff;} .btn-primary:hover{background:var(--blue-dark);}
.btn-light{background:#fff;color:var(--navy);border-color:#cfdbe9;} .btn-light:hover{background:#f4f8ff;}
.btn-ghost{background:transparent;color:#dbe7f5;border-color:rgba(255,255,255,.25);} .btn-ghost:hover{background:rgba(255,255,255,.12);color:#fff;}
.btn-danger{background:#fee2e2;color:var(--danger);} .btn-danger:hover{background:#fecaca;}
.btn-cloud{background:#0f766e;color:#fff;} .btn-cloud:hover{background:#0d5f59;}
.btn-sm{padding:6px 11px;font-size:12px;border-radius:7px;}
.btn-block{width:100%;}

.app-main{max-width:1600px;margin:0 auto;padding:18px;}
.view{display:none;} .view.active{display:block;}
.editor-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px;align-items:start;}

.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px 16px 18px;margin-bottom:16px;}
.card-title{margin:0 0 13px;font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--navy);padding-bottom:9px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
.card-title small{text-transform:none;letter-spacing:0;font-weight:600;color:var(--muted);font-size:11.5px;}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media (max-width:560px){.grid-2{grid-template-columns:1fr;}}
.fld{display:flex;flex-direction:column;gap:5px;min-width:0;}
.fld.full{grid-column:1 / -1;}
.fld > span{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;}
.inp{width:100%;border:1px solid #cfdae7;border-radius:8px;padding:8px 10px;font-size:13.5px;color:var(--text);background:#fff;transition:.15s;}
.inp:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.12);}
textarea.inp{resize:vertical;line-height:1.5;} select.inp{cursor:pointer;}

.item-toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:stretch;margin-bottom:14px;}
.item-toolbar select{flex:1 1 220px;min-width:0;}
.items-list{display:flex;flex-direction:column;gap:11px;}
.item-row{border:1px solid var(--border);border-radius:9px;padding:11px;background:#fbfcfe;}
.item-head{display:flex;gap:8px;align-items:center;margin-bottom:8px;}
.item-num{flex:0 0 24px;height:24px;border-radius:6px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11.5px;font-weight:700;}
.item-head .i-name{flex:1 1 auto;font-weight:600;}
.item-actions{display:flex;gap:4px;}
.icon-btn{width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:#fff;color:var(--muted);cursor:pointer;font-size:13px;line-height:1;display:flex;align-items:center;justify-content:center;transition:.15s;}
.icon-btn:hover{background:#eef2f7;color:var(--navy);}
.icon-btn:disabled{opacity:.35;cursor:not-allowed;}
.icon-btn.danger:hover{background:#fee2e2;color:var(--danger);border-color:#fecaca;}
.item-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;align-items:end;}
@media (max-width:640px){.item-grid{grid-template-columns:1fr 1fr;}}
.item-grid .fld > span{font-size:10px;}
.line-total b{display:block;padding:8px 10px;border-radius:8px;background:#eef4ff;color:var(--navy);font-size:13.5px;text-align:right;}
.empty-hint{padding:18px;text-align:center;color:var(--muted);border:1px dashed #cfdae7;border-radius:9px;font-size:13px;background:#fafcff;}

.term-row{display:flex;gap:8px;align-items:flex-start;margin-bottom:8px;}
.term-row textarea{flex:1;}
.term-row .icon-btn{flex:0 0 28px;margin-top:3px;}

.calc-box{margin-top:14px;border:1px solid var(--border);border-radius:9px;background:#f7f9fc;padding:12px 13px;font-size:13px;}
.calc-row{display:flex;justify-content:space-between;padding:4px 0;color:#44566c;gap:12px;}
.calc-row.total{border-top:2px solid var(--navy);margin-top:7px;padding-top:9px;font-weight:800;color:var(--navy);font-size:15.5px;}
.calc-row.sub{color:var(--muted);font-size:12.5px;}

.preview-pane{position:sticky;top:76px;}
.preview-toolbar{display:flex;gap:8px;flex-wrap:wrap;background:#fff;border:1px solid var(--border);border-radius:var(--radius) var(--radius) 0 0;border-bottom:0;padding:11px 12px;}
.preview-viewport{background:#e6ebf2;border:1px solid var(--border);border-radius:0 0 var(--radius) var(--radius);padding:14px;overflow:auto;max-height:calc(100vh - 170px);}
.preview-inner{margin:0 auto;} #pagesRoot{width:793.7px;}

.mobile-toggle{display:none;margin-bottom:12px;}
@media (max-width:1100px){
  .editor-grid{grid-template-columns:minmax(0,1fr);}
  .preview-pane{position:static;display:none;}
  .editor-grid.show-preview .form-pane{display:none;}
  .editor-grid.show-preview .preview-pane{display:block;}
  .mobile-toggle{display:block;}
  .preview-viewport{max-height:none;}
}

/* A4 document */
.pdf-page{width:793.7px;height:1122.5px;background:#fff;position:relative;overflow:hidden;box-sizing:border-box;padding:48px 52px 74px;font-family:'Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;color:#1c2b3a;font-size:12.5px;line-height:1.5;display:flex;flex-direction:column;margin:0 0 16px;}
#pagesRoot .pdf-page{box-shadow:0 3px 14px rgba(16,32,52,.16);}
.page-content{flex:1 1 auto;min-height:0;overflow:hidden;}
.q-pagefooter{position:absolute;left:52px;right:52px;bottom:26px;display:flex;justify-content:space-between;gap:12px;font-size:10px;color:#93a1b3;border-top:1px solid #e8edf3;padding-top:8px;}
.q-pagefooter b{color:#5b6b80;}

.q-header{display:flex;justify-content:space-between;align-items:flex-start;gap:22px;padding-bottom:14px;border-bottom:3px solid var(--navy);}
.q-header-left{display:flex;align-items:center;gap:14px;min-width:0;}
.q-logo{max-height:74px;max-width:210px;object-fit:contain;display:block;}
.q-logo-fallback{width:74px;height:74px;border-radius:16px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:23px;flex:0 0 auto;}
.q-brand-name{font-size:23px;font-weight:800;color:var(--navy);line-height:1.15;}
.q-brand-tag{font-size:10.5px;color:#6b7c93;text-transform:uppercase;letter-spacing:1.3px;margin-top:2px;font-weight:600;}
.q-header-right{text-align:right;font-size:11px;color:#4a5b70;line-height:1.65;flex:0 0 auto;max-width:250px;}
.q-header-right strong{color:var(--navy);}

.q-titleband{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-top:20px;padding-bottom:12px;border-bottom:1px solid #e8edf3;}
.q-title{font-size:27px;font-weight:800;letter-spacing:4px;color:var(--navy);line-height:1;}
.q-meta{display:flex;gap:24px;}
.q-meta > div{display:flex;flex-direction:column;gap:2px;}
.q-meta span{color:#93a1b3;text-transform:uppercase;letter-spacing:.9px;font-size:9.5px;font-weight:700;}
.q-meta b{color:#1c2b3a;font-size:12px;font-weight:700;}

.q-info{display:flex;gap:16px;margin-top:18px;}
.q-info > div{flex:1 1 0;min-width:0;background:#f8fafc;border:1px solid #e8edf3;border-radius:9px;padding:12px 14px;}
.q-info h3{font-size:9.5px;text-transform:uppercase;letter-spacing:1.1px;color:#93a1b3;margin:0 0 7px;font-weight:800;}
.q-info p{margin:2px 0;font-size:11.5px;color:#4a5b70;}
.q-info .q-strong{font-weight:800;font-size:13px;color:var(--navy);margin-bottom:3px;}
.q-info .q-lbl{color:#93a1b3;font-weight:600;}

.q-h2{font-size:12px;text-transform:uppercase;letter-spacing:1.5px;color:var(--navy);font-weight:800;margin:20px 0 8px;padding-bottom:5px;border-bottom:1.5px solid var(--navy);}
.q-h2 .cont{font-weight:600;text-transform:none;letter-spacing:0;color:#93a1b3;font-size:10.5px;}
.q-para{margin:0;font-size:12px;color:#42546a;line-height:1.65;}

.q-table{width:100%;border-collapse:collapse;font-size:11.5px;margin-top:2px;}
.q-table thead th{background:var(--navy);color:#fff;font-weight:600;text-align:left;padding:8px 9px;font-size:9.5px;text-transform:uppercase;letter-spacing:.7px;}
.q-table td{padding:8px 9px;border-bottom:1px solid #e8edf3;vertical-align:top;color:#3b4d63;}
.q-table tbody tr:nth-child(even) td{background:#fafbfd;}
.q-table .c-num{width:30px;text-align:center;color:#93a1b3;}
.q-table .c-qty{width:44px;text-align:center;}
.q-table .c-money{width:98px;text-align:right;white-space:nowrap;}
.q-table .c-item{width:24%;}
.q-table .c-item b{color:var(--navy);font-weight:700;}
.q-table .c-desc{color:#6b7c93;font-size:11px;margin-top:2px;}

.q-scope-item{display:flex;gap:9px;font-size:11.5px;color:#4a5b70;line-height:1.55;margin-bottom:5px;}
.q-scope-num{flex:0 0 22px;color:#93a1b3;font-weight:800;font-size:11px;padding-top:1px;}
.q-scope-item b{color:var(--navy);}
.q-scope-item .d{color:#6b7c93;}

.q-summary{margin-top:16px;margin-left:auto;width:330px;}
.q-summary-row{display:flex;justify-content:space-between;gap:12px;padding:6px 0;font-size:12px;color:#4a5b70;border-bottom:1px dashed #e8edf3;}
.q-summary-row.total{border-bottom:none;border-top:2px solid var(--navy);margin-top:5px;padding-top:10px;font-size:16px;font-weight:800;color:var(--navy);}

.q-pay{display:flex;gap:10px;margin-top:4px;}
.q-pay-item{flex:1 1 0;min-width:0;border:1px solid #e8edf3;border-radius:9px;padding:11px 12px;background:#f8fafc;}
.q-pay-item.highlight{background:#eef4ff;border-color:#c7dbff;}
.q-pay-item span{display:block;font-size:9.5px;text-transform:uppercase;letter-spacing:.9px;color:#93a1b3;font-weight:700;}
.q-pay-item b{display:block;font-size:15px;color:var(--navy);margin-top:4px;font-weight:800;}
.q-payment-text{margin:12px 0 0;font-size:11.5px;color:#42546a;line-height:1.65;}

.q-term-item{display:flex;gap:9px;font-size:11.5px;color:#4a5b70;line-height:1.55;margin-bottom:5px;}
.q-term-num{flex:0 0 22px;color:#93a1b3;font-weight:800;font-size:11px;padding-top:1px;}

.q-sign{display:flex;gap:26px;margin-top:26px;}
.q-sign > div{flex:1 1 0;}
.q-sign .q-sign-line{border-bottom:1px solid #a9b4c2;height:38px;}
.q-sign span{font-size:10px;color:#6b7c93;font-weight:600;letter-spacing:.4px;}

.table-wrap{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:auto;}
table.data-table{width:100%;border-collapse:collapse;font-size:13px;min-width:980px;}
table.data-table th{text-align:left;padding:11px 13px;background:#f7f9fc;font-size:10.5px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);font-weight:800;border-bottom:1px solid var(--border);white-space:nowrap;}
table.data-table td{padding:11px 13px;border-bottom:1px solid #eef2f7;vertical-align:middle;}
table.data-table tbody tr:hover{background:#fafcff;}
table.data-table tbody tr:last-child td{border-bottom:0;}
.q-num-cell{font-weight:700;color:var(--navy);white-space:nowrap;}
.q-amt-cell{font-weight:700;white-space:nowrap;}
.row-actions{display:flex;gap:5px;flex-wrap:wrap;}
.badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:10.5px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;}
.badge.draft{background:#eef2f7;color:#5b6b80;}
.badge.sent{background:#dbeafe;color:#1d4ed8;}
.badge.pending{background:#fef3c7;color:#b45309;}
.badge.accepted{background:#dcfce7;color:#15803d;}
.badge.paid{background:#d1fae5;color:#065f46;}
.badge.rejected{background:#fee2e2;color:#b91c1c;}
.badge.expired{background:#f1f5f9;color:#64748b;}
.toolbar-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px;}
.toolbar-row .inp{max-width:300px;}
.toolbar-row .spacer{flex:1 1 auto;}
.source-toggle{display:inline-flex;background:#fff;border:1px solid var(--border);border-radius:9px;overflow:hidden;}
.source-toggle button{border:0;background:transparent;padding:8px 14px;cursor:pointer;font-weight:600;font-size:12.5px;color:var(--muted);}
.source-toggle button.active{background:var(--navy);color:#fff;}

.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start;}
@media (max-width:900px){.settings-grid{grid-template-columns:1fr;}}
.logo-preview{display:flex;align-items:center;justify-content:center;border:1px dashed #cfdae7;border-radius:10px;background:#fafcff;min-height:140px;padding:14px;margin-bottom:12px;}
.logo-preview img{max-height:110px;max-width:100%;object-fit:contain;}
.notice{background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;border-radius:9px;padding:10px 12px;font-size:12.5px;margin-bottom:12px;line-height:1.5;}
.cloud-note{background:#f0fdfa;border:1px solid #99f6e4;color:#0f766e;border-radius:9px;padding:10px 12px;font-size:12.5px;margin:0 0 12px;line-height:1.6;}
.cloud-note b{color:#0f766e;}
.cloud-note code{background:#fff;padding:1px 5px;border-radius:4px;font-size:11.5px;}

.overlay{position:fixed;inset:0;z-index:200;background:#dfe5ee;display:none;flex-direction:column;}
.overlay.open{display:flex;}
.overlay-bar{background:var(--navy);color:#fff;padding:10px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;box-shadow:0 2px 10px rgba(9,24,42,.25);z-index:2;}
.overlay-bar .title{font-weight:700;font-size:14px;}
.overlay-bar .spacer{flex:1 1 auto;}
.client-body{flex:1 1 auto;overflow:auto;padding:18px;}
.client-inner{margin:0 auto;} #clientPages{width:793.7px;}
#clientPages .pdf-page{box-shadow:0 3px 14px rgba(16,32,52,.16);}

.loading{position:fixed;inset:0;z-index:400;background:rgba(14,42,71,.72);display:none;align-items:center;justify-content:center;flex-direction:column;gap:16px;color:#fff;}
.loading.open{display:flex;}
.spinner{width:42px;height:42px;border-radius:50%;border:4px solid rgba(255,255,255,.25);border-top-color:#fff;animation:spin .8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.loading p{margin:0;font-size:14px;font-weight:600;}
#toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(20px);background:var(--navy);color:#fff;padding:11px 20px;border-radius:9px;font-size:13px;font-weight:600;box-shadow:0 8px 24px rgba(9,24,42,.3);opacity:0;pointer-events:none;transition:.25s;z-index:500;max-width:88vw;text-align:center;}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
#pdfStage{position:absolute;left:-99999px;top:0;width:793.7px;background:#fff;pointer-events:none;z-index:-1;}
#pdfStage .pdf-page{box-shadow:none;margin:0;}

#printRoot{display:none;}
@media print{
  @page{size:A4;margin:0;}
  body{background:#fff !important;}
  body > *:not(#printRoot){display:none !important;}
  #printRoot{display:block !important;}
  #printRoot .pdf-page{margin:0 !important;box-shadow:none !important;page-break-after:always;break-after:page;}
  #printRoot .pdf-page:last-child{page-break-after:auto;break-after:auto;}
}
</style>
</head>
<body>

<header class="app-header">
  <div class="app-header-inner">
    <div class="brand">
      <img id="headerLogo" class="brand-logo" alt="G-7" style="display:none;">
      <div id="headerLogoFallback" class="brand-logo-fallback">G-7</div>
      <div class="brand-text">
        <h1>Quotation Generator</h1>
        <p id="headerWebsite">G-7.shop</p>
      </div>
    </div>
    <div class="header-spacer"></div>
    <span class="cloud-status" id="cloudStatus"><span class="dot"></span><span id="cloudStatusText">Cloud: not set</span></span>
    <nav class="header-nav">
      <button class="nav-btn active" data-view="editor">Editor</button>
      <button class="nav-btn" data-view="quotations">Quotations</button>
      <button class="nav-btn" data-view="settings">Settings</button>
    </nav>
    <button class="btn btn-ghost" id="newQuotationBtn">+ New Quotation</button>
  </div>
</header>

<main class="app-main">

  <!-- EDITOR -->
  <section id="view-editor" class="view active">
    <div class="mobile-toggle">
      <button class="btn btn-light btn-block" id="togglePreviewBtn">👁 Show Quotation Preview</button>
    </div>
    <div class="editor-grid" id="editorGrid">
      <div class="form-pane">

        <div class="card">
          <h2 class="card-title">Client Details</h2>
          <div class="grid-2">
            <label class="fld"><span>Client Name</span><input class="inp" data-path="client.name" placeholder="e.g. Rahul Sharma"></label>
            <label class="fld"><span>Business Name</span><input class="inp" data-path="client.business" placeholder="e.g. XYZ Clothing Store"></label>
            <label class="fld"><span>Email</span><input class="inp" type="email" data-path="client.email" placeholder="client@email.com"></label>
            <label class="fld"><span>Phone</span><input class="inp" data-path="client.phone" placeholder="+91 90000 00000"></label>
            <label class="fld full"><span>Address</span><textarea class="inp" rows="2" data-path="client.address" placeholder="City, State"></textarea></label>
            <label class="fld"><span>GST Number (optional)</span><input class="inp" data-path="client.gst" placeholder="22AAAAA0000A1Z5"></label>
          </div>
        </div>

        <div class="card">
          <h2 class="card-title">Quotation Details</h2>
          <div class="grid-2">
            <label class="fld"><span>Quotation Number <small id="cloudNumberHint" style="font-weight:600;text-transform:none;color:var(--muted);font-size:10.5px;"></small></span>
              <input class="inp" data-path="number">
