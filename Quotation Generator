/* ============================================================
   17. PAGINATION
   ============================================================ */
function newPage(state){
  const page=h('div','pdf-page');
  const content=h('div','page-content');
  const footer=h('div','q-pagefooter',
    '<div><b>'+esc(settings.businessName||'G-7')+'</b> · '+esc(settings.tagline||'')+'</div>'+
    '<div>'+esc(settings.website||'')+'</div>'+
    '<div class="page-num">Page 1 of 1</div>'
  );
  page.appendChild(content); page.appendChild(footer);
  state.container.appendChild(page);
  state.content=content; state.pages.push(page);
}
function overflowed(state){return state.content.scrollHeight>state.content.clientHeight+1;}
function placeBlock(block,state){
  const isH=block.classList&&block.classList.contains('q-h2');
  if(isH&&state.content.children.length>0){
    const remaining=state.content.clientHeight-state.content.scrollHeight;
    if(remaining<105) newPage(state);
  }
  state.content.appendChild(block);
  if(overflowed(state)&&state.content.children.length>1){
    state.content.removeChild(block);
    newPage(state);
    state.content.appendChild(block);
  }
}
function placeSection(sec,state){
  const head=sec.querySelector('.q-h2');
  const table=sec.querySelector('table.q-table');
  if(!table){placeBlock(sec,state);return;}
  const thead=table.querySelector('thead');
  const rows=Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
  if(!rows.length){placeBlock(sec,state);return;}
  let i=0,first=true,guard=0;
  while(i<rows.length&&guard++<400){
    const cont=h('div','q-section');
    if(first&&head) cont.appendChild(head.cloneNode(true));
    else cont.appendChild(h('h2','q-h2',(head?head.textContent:'Continued')+' <span class="cont">(continued)</span>'));
    const t=h('table','q-table');
    if(thead) t.appendChild(thead.cloneNode(true));
    const tb=document.createElement('tbody'); t.appendChild(tb); cont.appendChild(t);
    state.content.appendChild(cont);
    let added=0,broke=false,forced=false;
    while(i+added<rows.length){
      tb.appendChild(rows[i+added].cloneNode(true));
      if(overflowed(state)){
        tb.removeChild(tb.lastChild);
        if(added===0){
          state.content.removeChild(cont);
          if(state.content.children.length===0){
            tb.appendChild(rows[i].cloneNode(true));
            state.content.appendChild(cont);
            i+=1; forced=true;
          }
          newPage(state); broke=true; break;
        }
        i+=added; newPage(state); broke=true; break;
      }
      added++;
    }
    if(broke){if(added>0||forced) first=false; continue;}
    i+=added; first=false;
  }
}
function paginate(blocks,container){
  container.innerHTML='';
  const state={container,content:null,pages:[]};
  newPage(state);
  blocks.forEach(b=>{
    if(b.classList&&b.classList.contains('q-section')) placeSection(b,state);
    else placeBlock(b,state);
  });
  const total=state.pages.length;
  state.pages.forEach((p,i)=>{
    const n=p.querySelector('.page-num');
    if(n) n.textContent='Page '+(i+1)+' of '+total;
  });
  return state.pages;
}

